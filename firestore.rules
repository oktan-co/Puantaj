rules_version = '2';

// Puantaj Merkezi — yetki kuralları
// Roller (kullanicilar/{uid}.rol):
//   sube    → şube müdürü: sadece kendi şubelerinin AÇIK haftaları + personeli + haftayı kapatma (kapatılan hafta ona gizlenir)
//   bolge   → bölge müdürü: kendi şubelerinin çizelgesi + puantajı + onay
//   isveren → her şey
// Puantaj ve maaş verisi ayrı yollarda tutulur; şube müdürü bunlara hiç erişemez.

service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() { return request.auth != null; }
    function ben() { return get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data; }
    function aktif() { return girisli()
      && exists(/databases/$(database)/documents/kullanicilar/$(request.auth.uid))
      && ben().aktif == true; }
    function isveren() { return aktif() && ben().rol == 'isveren'; }
    function subede(s) { return aktif() && (ben().rol == 'isveren' || s in ben().subeler); }
    function bolgede(s) { return aktif() && (ben().rol == 'isveren' || (ben().rol == 'bolge' && s in ben().subeler)); }
    function kurulumYapildi() { return exists(/databases/$(database)/documents/sistem/kurulum); }

    // İlk kurulum: sistemde hiç işveren yokken, giriş yapan ilk kişi kendini işveren yapabilir.
    match /sistem/kurulum {
      allow read: if girisli();
      allow create: if girisli() && !kurulumYapildi()
        && getAfter(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.rol == 'isveren';
      allow update, delete: if false;
    }

    // Şube adları listesi (SGK şubesi seçimi için) — tüm aktif kullanıcılar okur, sadece işveren yazar.
    match /sistem/subeAdlari {
      allow read: if aktif();
      allow write: if isveren();
    }

    match /kullanicilar/{uid} {
      allow read: if girisli() && (request.auth.uid == uid || isveren());
      allow create: if isveren()
        || (girisli() && request.auth.uid == uid && !kurulumYapildi()
            && request.resource.data.rol == 'isveren' && request.resource.data.aktif == true);
      allow update, delete: if isveren();
    }

    // Kullanıcı adı → giriş e-postası eşlemesi gerekmez; giriş e-postası kullanıcı adından üretilir.

    // Personel: ortak havuz yok. Kişi, çalıştığı şubenin, SGK şubesinin ve diğer çalıştığı şubelerin (gorunurSubeler) listesinde görünür.
    // Diğer çalıştığı şubeleri (ekSubeler / gorunurSubeler) sadece işveren ve bölge müdürü (eklenen/çıkarılan şube kendi şubesiyse) değiştirir.
    function ekDegisimiUygun() {
      let eski = resource.data.get('ekSubeler', []);
      let yeni = request.resource.data.get('ekSubeler', []);
      let gorEski = resource.data.get('gorunurSubeler', []);
      let gorYeni = request.resource.data.get('gorunurSubeler', []);
      // Diğer çalıştığı şubeler değişmiyorsa görünür şubeler sadece büyüyebilir (çalıştığı / SGK şubesi değişince eski şube eklenir).
      return (eski == yeni && gorYeni.hasAll(gorEski))
        || isveren()
        || (aktif() && ben().rol == 'bolge'
            && ben().subeler.hasAll(yeni.removeAll(eski))
            && ben().subeler.hasAll(eski.removeAll(yeni))
            && gorYeni.hasAll(gorEski));
    }
    match /personel/{p} {
      allow read: if subede(resource.data.get('anaSube', ''))
        || subede(resource.data.get('sgkSube', ''))
        || (aktif() && ben().subeler.hasAny(resource.data.get('gorunurSubeler', [])));
      allow create: if (subede(request.resource.data.anaSube)
        || subede(request.resource.data.get('sgkSube', '')))
        && (request.resource.data.get('ekSubeler', []).size() == 0 || ben().rol in ['bolge', 'isveren']);
      allow update: if ekDegisimiUygun() && (
        ((subede(resource.data.anaSube) || subede(resource.data.get('sgkSube', '')))
          && (subede(request.resource.data.anaSube) || subede(request.resource.data.get('sgkSube', ''))))
        || (aktif() && ben().rol == 'bolge'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ekSubeler', 'gorunurSubeler'])));
      // Silme sadece işveren: silinen kişinin geçmiş haftaları ve puantajı hesaplardan düşer (uygulama kaydı olanı zaten sildirmez).
      allow delete: if isveren();
    }

    // Şubenin "diğer şubeden çalışanlar" listesi (kişi kimlikleri). Şube okur, bölge müdürü / işveren yazar.
    // Bölge müdürü / işveren yönetir; diğer aktif kullanıcılar sadece kişi ekleyebilir (şube değişikliğinde eski şube kişiyi görmeye devam etsin), çıkaramaz.
    match /ekPersonel/{s} {
      allow read: if subede(s);
      allow create, update: if bolgede(s)
        || (aktif() && request.resource.data.keys().hasOnly(['ids'])
            && (resource == null || request.resource.data.ids.keys().hasAll(resource.data.get('ids', {}).keys())));
      allow delete: if bolgede(s);
    }

    // Kişinin gün gün hangi şubede ne yazıldığı (aynı gün tek şube kuralı ve başka şubede çalıştığı günler için).
    // Sadece saat ve izin kodu tutulur; ücret bilgisi yoktur. Kişinin şubelerinden birine yetkisi olan okur ve yazar.
    match /gunler/{d} {
      allow read: if aktif() && (ben().rol == 'isveren' || ben().subeler.hasAny(resource.data.get('subeler', [])));
      allow write: if aktif() && request.resource != null
        && (ben().rol == 'isveren' || ben().subeler.hasAny(request.resource.data.subeler))
        && (resource == null || ben().rol == 'isveren' || ben().subeler.hasAny(resource.data.get('subeler', [])));
    }

    // Şubelerin aylık saat/izin özeti (maaşın ödendiği şubenin puantajı diğer şubelerdeki izinleri buradan toplar).
    match /ozetler/{d} {
      allow read: if aktif() && (ben().rol in ['bolge', 'isveren'] || subede(resource.data.sube));
      allow write: if request.resource != null && bolgede(request.resource.data.sube)
        && d == request.resource.data.ay + '__' + request.resource.data.sube;
    }

    match /sistem/goc {
      allow read: if aktif();
      allow write: if isveren();
    }

    match /subeler/{s} {
      allow read: if subede(s);
      allow create, delete: if isveren();
      allow update: if isveren();

      match /personel/{p} {
        allow read, write: if subede(s);
      }

      // Haftalık kapatma: hd = acik | kapali | onay. Şube müdürü sadece açık haftayı okur ve yazar; kapatabilir (acik → kapali) ama geri açamaz.
      // Bölge müdürü (kendi şubeleri) ve işveren her haftayı okur, yazar, onaylar, geri gönderir, kilidi açar.
      match /haftalar/{w} {
        allow read: if bolgede(s)
          || (subede(s) && (resource == null || !('hd' in resource.data) || resource.data.hd == 'acik'));
        allow write: if bolgede(s)
          || (subede(s) && !ayKilitli(s, w)
              && request.resource != null
              && (resource == null || resource.data.get('hd', 'acik') == 'acik')
              && request.resource.data.get('hd', 'acik') in ['acik', 'kapali'])
          // Onaylı ayın kilidi, haftayı sadece kapatmayı (acik → kapali) engellemez; çizelge hücreleri değişmez.
          || (subede(s) && resource != null && resource.data.get('hd', 'acik') == 'acik'
              && request.resource.data.get('hd', 'acik') == 'kapali'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hafta', 'ay2', 'hd', 'kapatma', 'kapatan', 'kapatanAd', 'geriNot', 'kayit']))
          // Onaylı aya değen açık haftada şube müdürü, kapatmadan önce 7 gün çalışan teyidini (teyit7) ve rapor / izin / giriş / çıkış teyidini (teyitK) işaretleyebilir; hücreler değişmez.
          || (subede(s) && resource != null && resource.data.get('hd', 'acik') == 'acik'
              && request.resource.data.get('hd', 'acik') == 'acik'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hafta', 'ay2', 'hd', 'teyit7', 'teyitK']));
      }

      // Kapatılan haftaların listesi ve kişi bazında toplamları (şube müdürü kapalı haftayı göremediği için "bu haftaya kadar" toplamı buradan).
      // Şube müdürü sadece hafta ekler / günceller (haftayı kapatırken); kayıt silemez, belgeyi silemez.
      match /durum/{d} {
        allow read: if subede(s);
        allow create, update: if bolgede(s)
          || (subede(s) && request.resource.data.get('w', {}).keys().hasAll(resource == null ? [] : resource.data.get('w', {}).keys()));
        allow delete: if bolgede(s);
      }

      // Ay durumu: taslak → sube_onay → bolge_onay; bölge müdürü 'geri' ile iade edebilir.
      match /aylar/{a} {
        allow read: if subede(s);
        allow write: if bolgede(s)
          || (subede(s)
              && request.resource.data.durum in ['taslak', 'sube_onay']
              && (resource == null || resource.data.durum in ['taslak', 'sube_onay', 'geri']))
          // geri gönderilmiş ayda kontrol işaretleri (durum değişmeden)
          || (subede(s) && resource != null && resource.data.durum == 'geri'
              && request.resource.data.durum == 'geri');
      }
    }

    // Haftanın pazartesi tarihinden (YYYY-MM-DD) haftanın değdiği iki ayı bul ve kilitli mi bak.
    function ayDurum(s, ay) {
      return exists(/databases/$(database)/documents/subeler/$(s)/aylar/$(ay))
        ? get(/databases/$(database)/documents/subeler/$(s)/aylar/$(ay)).data.durum : 'taslak';
    }
    function ilkAy(w) { return w.split('-')[0] + '-' + w.split('-')[1]; }
    // Aylık şube kapatması kaldırıldı: şube müdürleri haftayı kapatır. Ay sadece bölge onayında kilitlenir (eski 'sube_onay' kayıtları kilit sayılmaz).
    function kilitliDurum(d) { return d == 'bolge_onay'; }
    function ayKilitli(s, w) {
      return kilitliDurum(ayDurum(s, ilkAy(w)))
        || (request.resource != null && request.resource.data.keys().hasAll(['ay2'])
            && request.resource.data.ay2 is string
            && kilitliDurum(ayDurum(s, request.resource.data.ay2)))
        || (resource != null && resource.data.keys().hasAll(['ay2'])
            && resource.data.ay2 is string
            && kilitliDurum(ayDurum(s, resource.data.ay2)));
    }

    // PUANTAJ — sadece sorumlu bölge müdürü ve işveren.
    match /puantaj/{s}/aylar/{a} {
      allow read: if bolgede(s);
      // Bölge onayından sonra muhasebe tarafı (sol) kilitlenir; ödemeler ve veri girişi devam eder.
      allow create: if bolgede(s);
      allow update: if isveren()
        || (bolgede(s) && (resource.data.get('kilitli', false) != true
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sag', 'veri', 'veriM', 'veriSil', 'guncellendi'])));
      allow delete: if isveren();
    }

    // Anlaşılan net maaşlar — sadece sorumlu bölge müdürü ve işveren.
    match /maaslar/{s} {
      allow read, write: if bolgede(s);
    }

    // DÜZENLEME KİLİDİ — aynı anda tek kişi düzenler. Çizelgede şube + hafta (tur 'cz'), puantajda şube + ay (tur 'pt').
    // Kilit son işlemden 2 dakika sonra düşer; o zamana kadar sadece sahibi tazeler.
    // İşveren her kilidi, bölge müdürü (kendi şubesinde) şube müdürünün kilidini devralabilir.
    function kilitYetki(d) {
      return d.tur == 'pt' ? bolgede(d.sube) : subede(d.sube);
    }
    function kilitSahibiRol(d) {
      return exists(/databases/$(database)/documents/kullanicilar/$(d.uid))
        ? get(/databases/$(database)/documents/kullanicilar/$(d.uid)).data.rol : '';
    }
    match /kilitler/{k} {
      allow read: if aktif() && (resource == null || kilitYetki(resource.data));
      allow create, update: if aktif()
        && request.resource.data.keys().hasOnly(['tur', 'sube', 'donem', 'uid', 'ad', 'rol', 't'])
        && request.resource.data.tur in ['cz', 'pt']
        && request.resource.data.sube is string && request.resource.data.donem is string
        && k == request.resource.data.tur + '__' + request.resource.data.sube + '__' + request.resource.data.donem
        && kilitYetki(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t == request.time
        && (resource == null
            || resource.data.uid == request.auth.uid
            || request.time > resource.data.t + duration.value(120, 's')
            || isveren()
            || (bolgede(resource.data.sube) && kilitSahibiRol(resource.data) == 'sube'));
      allow delete: if aktif() && (resource.data.uid == request.auth.uid || isveren());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
